{
  "name": "pool2d",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "dev:vite": "vite --host 0.0.0.0",
    "dev:relay": "node scripts/relay-server.js",
    "dev:table-save": "node scripts/table-editor-save-server.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.js",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "build:ios": "npm run build && npx cap sync ios",
    "ios:open": "open ios/App/App.xcworkspace"
  },
  "dependencies": {
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/screen-orientation": "^7.0.2",
    "dexie": "^4.2.1",
    "three": "^0.160.1",
    "three-stdlib": "^2.36.0",
    "tslib": "^2.8.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.160.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.34.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
